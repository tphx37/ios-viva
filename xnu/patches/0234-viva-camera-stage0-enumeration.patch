diff --git a/iokit/Kernel/arm/VivaCamera.cpp b/iokit/Kernel/arm/VivaCamera.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/VivaCamera.cpp
@@ -0,0 +1,41 @@
+/*
+ * viva (MT6781): camera hardware enumeration, stage 0.
+ *
+ * This is deliberately metadata-only. Do not map CAMSYS, touch the PMIC,
+ * configure clocks/GPIO, or communicate with the image sensor at this stage.
+ * A later patch can add guarded and explicitly enabled hardware bring-up.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <libkern/OSData.h>
+
+class VivaCamera : public IOService {
+    OSDeclareDefaultStructors(VivaCamera);
+public:
+    virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(VivaCamera, IOService);
+
+bool
+VivaCamera::start(IOService *provider)
+{
+    if (!IOService::start(provider))
+        return false;
+
+    OSData *readonly = OSDynamicCast(OSData, provider->getProperty("probe-only"));
+    if (readonly == NULL || readonly->getLength() != sizeof(uint32_t) ||
+        *(const uint32_t *)readonly->getBytesNoCopy() != 1) {
+        IOLog("VIVA CAM: missing stage-0 safety property, refusing start\n");
+        return false;
+    }
+
+    setProperty("VivaCameraStage", "enumeration-only");
+    IOLog("VIVA CAM: stage 0 registered (no MMIO, GPIO, I2C or power operations)\n");
+    registerService();
+    return true;
+}
+#endif /* SWEET */
